# =============================================================================
# Pharmacy Claim Orchestration — Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
DISCLAIMER=Educational demo only. Not for real insurance billing, medical advice, or PHI. Use synthetic member/claim data only.
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
LOG_LEVEL=INFO

# --- LLM Provider: openai | azure ---
LLM_PROVIDER=openai

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI (when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# LLM call settings
LLM1_TEMPERATURE=0.1
LLM2_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_FORCE_FALLBACK=false

# --- LangSmith tracing (optional but recommended) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=pharmacy-claim-orchestration
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Public API timeouts / retries ---
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3

# --- Offline eval ---
EVAL_USE_LLM_JUDGE=false
EVAL_JUDGE_MODEL=gpt-4o-mini
